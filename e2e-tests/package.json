{
  "name": "giant-e2e-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Cucumber scenarios run with Playwright against an isolated Giant instance.",
  "scripts": {
    "test": "node run.mts",
    "test:ui": "node run.mts --ui --ui-host=0.0.0.0 --ui-port=9423",
    "test:run": "bddgen && playwright test",
    "test:list": "bddgen && playwright test --list",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "playwright-bdd": "9.2.1",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "zx": "8.8.5"
  }
}
