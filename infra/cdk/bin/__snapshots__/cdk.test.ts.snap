          "LaunchTemplate": {
            "LaunchTemplateSpecification": {
              "LaunchTemplateId": {
                "Ref": "WorkerLaunchTemplate",
              },
              "Version": {
                "Fn::GetAtt": "WorkerLaunchTemplate.LatestVersionNumber",
              },
            },
            "Overrides": [
              {
                "InstanceRequirements": {
                  "BurstablePerformance": {
                    "Fn::FindInMap": [
                      "StackVariables",
