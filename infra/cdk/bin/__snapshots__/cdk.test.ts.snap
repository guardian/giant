    "WorkerAutoScalingGroup": {
      "Properties": {
        "AvailabilityZones": {
          "Fn::GetAZs": "",
        },
        "Cooldown": "180",
        "HealthCheckGracePeriod": 300,
        "HealthCheckType": "ELB",
        "LaunchTemplate": {
          "LaunchTemplateId": {
            "Ref": "WorkerLaunchTemplate",
          },
          "Version": {
            "Fn::GetAtt": "WorkerLaunchTemplate.LatestVersionNumber",
          },
        },
        "MaxSize": {
          "Fn::If": [
            "DeployInstances",
            {
              "Ref": "MaxNumberOfWorkersIncludingHeadroomForDeploy",
            },
            0,
          ],
        },
        "MetricsCollection": [
          {
            "Granularity": "1Minute",
          },
        ],
        "MinSize": {
          "Fn::If": [
            "DeployInstances",
            {
              "Ref": "MinNumberOfWorkers",
            },
            0,
          ],
        },
        "Tags": [
          {
            "Key": "App",
            "PropagateAtLaunch": true,
            "Value": "pfi",
          },
          {
            "Key": "gu:cdk:version",
            "PropagateAtLaunch": true,
            "Value": "TEST",
          },
          {
            "Key": "gu:repo",
            "PropagateAtLaunch": true,
            "Value": "guardian/giant",
          },
          {
