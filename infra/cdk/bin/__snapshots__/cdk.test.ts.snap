    },
    "WorkerFailureAlarm": {
      "Condition": "IsProd",
      "Properties": {
        "AlarmActions": [
          {
            "Fn::ImportValue": {
              "Fn::Sub": "\${Stack}-shared-AlertTopic",
            },
          },
        ],
        "AlarmDescription": "Errors from ingest workers",
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "Dimensions": [
          {
            "Name": "Stack",
            "Value": {
              "Ref": "Stack",
            },
          },
          {
            "Name": "Stage",
            "Value": {
              "Ref": "Stage",
            },
          },
        ],
        "EvaluationPeriods": 1,
        "MetricName": "IngestItemsFailed",
        "Namespace": "PFI",
        "Period": 60,
        "Statistic": "Sum",
        "Tags": [
          {
            "Key": "App",
            "Value": "pfi",
          },
          {
            "Key": "gu:cdk:version",
            "Value": "TEST",
          },
          {
            "Key": "gu:repo",
            "Value": "guardian/giant",
          },
          {
            "Key": "Stack",
            "Value": "pfi-playground",
          },
          {
            "Key": "Stage",
            "Value": "rex",
          },
        ],
        "Threshold": 1,
        "TreatMissingData": "notBreaching",
      },
      "Type": "AWS::CloudWatch::Alarm",
    },
    "WorkerInstanceProfile": {
      "Properties": {
        "Path": "/",
        "Roles": [
          {
            "Ref": "WorkerRole",
          },
        ],
      },
      "Type": "AWS::IAM::InstanceProfile",
    },
    "WorkerLaunchTemplate": {
      "Properties": {
        "LaunchTemplateData": {
          "IamInstanceProfile": {
            "Arn": {
              "Fn::GetAtt": "WorkerInstanceProfile.Arn",
            },
          },
          "ImageId": {
            "Ref": "AMI",
          },
          "InstanceType": {
            "Ref": "WorkerInstanceType",
          },
          "MetadataOptions": {
            "HttpTokens": "required",
          },
          "SecurityGroupIds": [
            {
              "Fn::ImportValue": {
                "Fn::Sub": "\${Stack}-shared-CommonInstanceSecurityGroup",
              },
            },
            {
              "Fn::ImportValue": {
                "Fn::Sub": "\${PostgresStackName}-DbAccessSecurityGroup",
              },
            },
            {
              "Fn::GetAtt": "Neo4jAccessSecurityGroup.GroupId",
            },
            {
              "Fn::GetAtt": "ElasticsearchAccessSecurityGroup.GroupId",
            },
            {
              "Fn::GetAtt": "WorkerSecurityGroup.GroupId",
            },
          ],
          "UserData": {
            "Fn::Base64": {
              "Fn::Sub": [
                "#!/bin/bash -ev
export AWS_DEFAULT_REGION=\${AWS::Region}
aws s3 cp s3://\${DistBucket}/\${Stack}/\${Stage}/pfi/scripts/setup-pfi-instance.sh .
chmod u=rwx setup-pfi-instance.sh
./setup-pfi-instance.sh \${DistBucket} \${AWS::StackName} \${DataVolumeKeyArn}
",
                {
                  "DataVolumeKeyArn": {
                    "Fn::ImportValue": {
                      "Fn::Sub": "\${Stack}-shared-KmsKeyArn",
                    },
                  },
                  "DistBucket": {
                    "Fn::ImportValue": {
                      "Fn::Sub": "\${Stack}-shared-DistBucket",
                    },
                  },
                },
              ],
            },
          },
        },
      },
      "Type": "AWS::EC2::LaunchTemplate",
    },
    "WorkerRole": {
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Statement": {
            "Action": [
              "sts:AssumeRole",
            ],
            "Effect": "Allow",
            "Principal": {
              "Service": [
                "ec2.amazonaws.com",
              ],
            },
          },
        },
        "ManagedPolicyArns": [
          {
            "Fn::ImportValue": {
              "Fn::Sub": "\${Stack}-shared-CommonInstancePolicy",
            },
          },
        ],
        "Path": "/",
        "Policies": [
          {
            "PolicyDocument": {
              "Statement": [
                {
                  "Action": [
                    "sqs:SendMessage",
                    "sqs:GetQueueAttributes",
                    "sqs:GetQueueUrl",
                  ],
                  "Effect": "Allow",
                  "Resource": [
                    {
                      "Ref": "TranscriptionServiceTaskQueueArn",
                    },
                    {
                      "Ref": "TranscriptionServiceGpuTaskQueueArn",
                    },
                  ],
                },
                {
                  "Action": [
                    "sqs:ReceiveMessage",
                    "sqs:ChangeMessageVisibility",
                    "sqs:GetQueueUrl",
                    "sqs:DeleteMessage",
                    "sqs:GetQueueAttributes",
                  ],
                  "Effect": "Allow",
                  "Resource": [
                    {
                      "Fn::GetAtt": "TranscriptionOutputQueue.Arn",
                    },
                    {
                      "Fn::GetAtt": "MediaDownloadOutputQueue.Arn",
                    },
                  ],
                },
                {
                  "Action": [
                    "sqs:SendMessage",
                  ],
                  "Effect": "Allow",
                  "Resource": [
                    {
                      "Fn::GetAtt": "TranscriptionOutputDeadLetterQueue.Arn",
                    },
                    {
                      "Fn::GetAtt": "MediaDownloadOutputDeadLetterQueue.Arn",
                    },
                  ],
                },
                {
                  "Action": [
                    "s3:GetObject",
                    "s3:PutObject",
                  ],
                  "Effect": "Allow",
                  "Resource": [
                    {
                      "Fn::Sub": "arn:aws:s3:::\${Stack}-transcription-output-data-\${Stage}/*",
                    },
                  ],
                },
                {
                  "Action": [
                    "s3:GetObject",
                    "s3:ListBucket",
                  ],
                  "Effect": "Allow",
                  "Resource": [
                    {
                      "Fn::Sub": "arn:aws:s3:::\${Stack}-remote-ingest-data-\${Stage}/*",
                    },
                    {
                      "Fn::Sub": "arn:aws:s3:::\${Stack}-remote-ingest-data-\${Stage}",
                    },
                  ],
                },
              ],
              "Version": "2012-10-17",
            },
            "PolicyName": "TranscriptionPolicy",
          },
        ],
        "Tags": [
          {
            "Key": "App",
            "Value": "pfi",
          },
          {
            "Key": "gu:cdk:version",
            "Value": "TEST",
          },
          {
            "Key": "gu:repo",
            "Value": "guardian/giant",
          },
          {
            "Key": "Stack",
            "Value": "pfi-playground",
          },
          {
            "Key": "Stage",
            "Value": "rex",
          },
        ],
      },
      "Type": "AWS::IAM::Role",
    },
    "WorkerSecurityGroup": {
      "Properties": {
        "GroupDescription": "Investigations workers",
        "SecurityGroupEgress": [
          {
            "DestinationSecurityGroupId": {
              "Fn::ImportValue": {
                "Fn::Sub": "\${Stack}-router-WorkerLoadBalancerSecurityGroup",
              },
            },
            "FromPort": 9001,
            "IpProtocol": "tcp",
            "ToPort": 9001,
          },
        ],
        "SecurityGroupIngress": [
          {
            "FromPort": 9001,
            "IpProtocol": "tcp",
            "SourceSecurityGroupId": {
              "Fn::ImportValue": {
                "Fn::Sub": "\${Stack}-router-WorkerLoadBalancerSecurityGroup",
              },
            },
            "ToPort": 9001,
          },
        ],
        "Tags": [
          {
            "Key": "App",
            "Value": "pfi",
          },
          {
            "Key": "gu:cdk:version",
            "Value": "TEST",
          },
          {
            "Key": "gu:repo",
            "Value": "guardian/giant",
          },
          {
            "Key": "Stack",
            "Value": "pfi-playground",
          },
          {
            "Key": "Stage",
            "Value": "rex",
          },
        ],
        "VpcId": {
          "Fn::ImportValue": {
            "Fn::Sub": "\${VPCStackName}-ID",
          },
        },
      },
      "Type": "AWS::EC2::SecurityGroup",
    },
  },
}
`;

exports[`Giant's stacks should match the snapshots 4`] = `
{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Conditions": {
    "DeployInstances": {
      "Fn::Equals": [
        {
          "Ref": "DeployInstances",
        },
        true,
      ],
    },
    "IsProd": {
      "Fn::Equals": [
        {
          "Ref": "Stack",
        },
        "pfi-giant",
      ],
    },
  },
  "Description": "Investigations PFI cluster",
  "Mappings": {
    "StackVariables": {
      "pfi-giant": {
        "MaxWebAppInstanceCount": 6,
        "MinWebAppInstanceCount": 3,
        "WebAppInstanceType": "t4g.medium",
        "WorkerBurstablePerformance": "excluded",
      },
      "pfi-playground": {
        "MaxWebAppInstanceCount": 2,
        "MinWebAppInstanceCount": 1,
        "WebAppInstanceType": "t4g.medium",
        "WorkerBurstablePerformance": "required",
      },
    },
  },
  "Metadata": {
    "gu:cdk:constructs": [
      "GuVpcParameter",
    ],
    "gu:cdk:version": "TEST",
  },
  "Outputs": {
    "FrontendAutoScalingGroup": {
      "Description": "Autoscaling groups for the frontend",
      "Export": {
        "Name": {
          "Fn::Sub": "\${AWS::StackName}-FrontendAutoScalingGroup",
        },
      },
      "Value": {
        "Ref": "FrontendAutoScalingGroup",
      },
    },
    "SpotWorkerAutoScalingGroup": {
      "Description": "Autoscaling groups for the workers",
      "Export": {
        "Name": {
          "Fn::Sub": "\${AWS::StackName}-SpotWorkerAutoScalingGroup",
        },
      },
      "Value": {
        "Ref": "SpotWorkerAutoScalingGroup",
      },
    },
    "WorkerAutoScalingGroup": {
      "Description": "Autoscaling groups for the workers",
      "Export": {
        "Name": {
          "Fn::Sub": "\${AWS::StackName}-WorkerAutoScalingGroup",
        },
      },
      "Value": {
        "Ref": "WorkerAutoScalingGroup",
      },
    },
  },
  "Parameters": {
    "AMI": {
      "Type": "String",
    },
    "AuthDomain": {
      "Default": "gutools.co.uk",
      "Description": "The domain to be used for panda and redirection to the login service. Required when panda is chosen as the AuthProvider.",
      "Type": "String",
    },
    "AuthProvider": {
      "AllowedValues": [
        "database",
        "panda",
      ],
      "Default": "database",
      "Description": "Which authentication provider to use.",
      "Type": "String",
    },
    "DeployInstances": {
      "AllowedValues": [
        true,
        false,
      ],
      "Default": true,
      "Type": "String",
    },
    "MaxNumberOfWorkersIncludingHeadroomForDeploy": {
      "Default": 6,
      "Description": "Should be double the actual max number of workers to leave headroom for a Riff-Raff deploy",
      "Type": "Number",
    },
    "MinNumberOfWorkers": {
      "Default": 1,
      "Description": "The minimum number of workers.",
      "Type": "Number",
    },
    "PostgresStackName": {
      "Description": "Cloudformation stack defining the Postgres RDS instance",
      "Type": "String",
    },
    "RemoteIngestTopicArn": {
      "Description": "Transcription remote ingest topic arn",
      "Type": "String",
    },
    "RequireTwoFactor": {
      "AllowedValues": [
        true,
        false,
      ],
      "Default": true,
      "Type": "String",
    },
    "Stack": {
      "AllowedValues": [
        "pfi-giant",
        "pfi-playground",
        "pfi-llama",
      ],
      "Description": "Stack name",
      "Type": "String",
    },
    "Stage": {
      "AllowedValues": [
        "rex",
      ],
      "Default": "rex",
      "Type": "String",
    },
    "TranscriptionServiceGpuTaskQueueArn": {
      "Description": "Transcription service task queue",
      "Type": "String",
    },
    "TranscriptionServiceTaskQueueArn": {
      "Description": "Transcription service task queue",
      "Type": "String",
    },
    "VPCStackName": {
      "Description": "Cloudformation stack defining the VPC",
      "Type": "String",
    },
    "VpcId": {
      "Default": "/account/vpc/giant/id",
      "Description": "Virtual Private Cloud to run EC2 instances within. Should NOT be the account default VPC.",
      "Type": "AWS::SSM::Parameter::Value<AWS::EC2::VPC::Id>",
    },
    "WorkerDataVolumeSize": {
      "Description": "Size of data volume for the worker instances (in GB)",
      "Type": "Number",
    },
    "WorkerInstanceType": {
      "Default": "m7g.large",
      "Description": "Instance type to use for on-demand worker instance (we use spot instances for scaling the workers)",
      "Type": "String",
    },
  },
  "Resources": {
    "CommonInstancePolicy": {
      "Properties": {
        "PolicyDocument": {
          "Statement": [
            {
              "Action": "s3:*",
              "Effect": "Allow",
              "Resource": {
                "Fn::Sub": "arn:aws:s3:::\${Stack}-ingest-data-\${Stage}",
              },
            },
            {
              "Action": "s3:*",
              "Effect": "Allow",
              "Resource": {
                "Fn::Sub": "arn:aws:s3:::\${Stack}-ingest-data-\${Stage}/*",
              },
            },
            {
              "Action": "s3:*",
              "Effect": "Allow",
              "Resource": {
                "Fn::Sub": "arn:aws:s3:::\${Stack}-data-\${Stage}",
              },
            },
            {
              "Action": "s3:*",
              "Effect": "Allow",
              "Resource": {
                "Fn::Sub": "arn:aws:s3:::\${Stack}-ingest-data-dead-letter-\${Stage}",
              },
            },
            {
              "Action": "s3:*",
              "Effect": "Allow",
              "Resource": {
                "Fn::Sub": "arn:aws:s3:::\${Stack}-ingest-data-dead-letter-\${Stage}/*",
              },
            },
            {
              "Action": "s3:*",
              "Effect": "Allow",
              "Resource": {
                "Fn::Sub": "arn:aws:s3:::\${Stack}-data-\${Stage}/*",
              },
            },
            {
              "Action": "s3:*",
              "Effect": "Allow",
              "Resource": {
                "Fn::Sub": "arn:aws:s3:::\${Stack}-performance-data-\${Stage}",
              },
            },
            {
              "Action": "s3:*",
              "Effect": "Allow",
              "Resource": {
                "Fn::Sub": "arn:aws:s3:::\${Stack}-performance-data-\${Stage}/*",
              },
            },
            {
              "Action": "s3:*",
              "Effect": "Allow",
              "Resource": {
                "Fn::Sub": "arn:aws:s3:::\${Stack}-preview-\${Stage}",
              },
            },
            {
              "Action": "s3:*",
              "Effect": "Allow",
              "Resource": {
                "Fn::Sub": "arn:aws:s3:::\${Stack}-preview-\${Stage}/*",
              },
            },
            {
              "Action": "s3:*",
              "Effect": "Allow",
              "Resource": {
                "Fn::Sub": "arn:aws:s3:::\${Stack}-source-data",
              },
            },
            {
              "Action": "s3:*",
              "Effect": "Allow",
              "Resource": {
                "Fn::Sub": "arn:aws:s3:::\${Stack}-source-data/*",
              },
            },
            {
              "Action": "s3:GetObject",
              "Effect": "Allow",
              "Resource": {
                "Fn::Sub": "arn:aws:s3:::pan-domain-auth-settings/\${AuthDomain}.settings.public",
              },
            },
            {
              "Action": "s3:GetObject",
              "Effect": "Allow",
              "Resource": "arn:aws:s3:::investigations-testing-data/*",
            },
            {
              "Action": "s3:GetObject",
              "Effect": "Allow",
              "Resource": "arn:aws:s3:::investigations-source-data/*",
            },
            {
              "Action": "ssm:GetParameter",
              "Effect": "Allow",
              "Resource": {
                "Fn::Sub": "arn:aws:ssm:\${AWS::Region}:\${AWS::AccountId}:parameter/pfi/\${Stack}/\${Stage}/*",
              },
            },
            {
              "Action": "cloudformation:DescribeStacks",
              "Effect": "Allow",
              "Resource": {
                "Fn::Sub": "\${AWS::StackId}",
              },
            },
            {
              "Action": "secretsmanager:GetSecretValue",
              "Effect": "Allow",
              "Resource": {
                "Fn::ImportValue": {
                  "Fn::Sub": "\${PostgresStackName}-PostgresDbSecretArn",
                },
              },
            },
          ],
        },
        "PolicyName": "BucketPolicy",
        "Roles": [
          {
            "Ref": "FrontendRole",
          },
          {
            "Ref": "WorkerRole",
          },
        ],
      },
      "Type": "AWS::IAM::Policy",
    },
    "CommonSecurityGroup": {
      "Properties": {
        "GroupDescription": "Rules common to PFI workers and frontend",
        "SecurityGroupEgress": [
          {
            "DestinationPrefixListId": "pl-6da54004",
            "FromPort": 443,
            "IpProtocol": "tcp",
            "ToPort": 443,
          },
        ],
        "SecurityGroupIngress": [
          {
            "CidrIp": "10.0.0.0/8",
            "FromPort": -1,
            "IpProtocol": "icmp",
            "ToPort": -1,
          },
        ],
        "Tags": [
          {
            "Key": "App",
            "Value": "pfi",
          },
          {
            "Key": "gu:cdk:version",
            "Value": "TEST",
          },
          {
            "Key": "gu:repo",
            "Value": "guardian/giant",
          },
          {
            "Key": "Stack",
            "Value": "pfi-giant",
          },
          {
            "Key": "Stage",
            "Value": "rex",
          },
        ],
        "VpcId": {
          "Fn::ImportValue": {
            "Fn::Sub": "\${VPCStackName}-ID",
          },
        },
      },
      "Type": "AWS::EC2::SecurityGroup",
    },
    "ElasticsearchAccessSecurityGroup": {
      "Properties": {
        "GroupDescription": "Investigations frontend and worker access to neo4j",
        "SecurityGroupEgress": [
          {
            "DestinationSecurityGroupId": {
              "Fn::ImportValue": {
                "Fn::Sub": "\${Stack}-elasticsearch-\${Stage}-ElasticsearchSecurityGroup",
              },
            },
            "FromPort": 9200,
            "IpProtocol": "tcp",
            "ToPort": 9200,
          },
        ],
        "Tags": [
          {
            "Key": "App",
            "Value": "pfi",
          },
          {
            "Key": "gu:cdk:version",
            "Value": "TEST",
          },
          {
            "Key": "gu:repo",
            "Value": "guardian/giant",
          },
          {
            "Key": "Stack",
            "Value": "pfi-giant",
          },
          {
            "Key": "Stage",
            "Value": "rex",
          },
        ],
        "VpcId": {
          "Fn::ImportValue": {
            "Fn::Sub": "\${VPCStackName}-ID",
          },
        },
      },
      "Type": "AWS::EC2::SecurityGroup",
    },
    "ElasticsearchHTTPIngress": {
      "Properties": {
        "FromPort": 9200,
        "GroupId": {
          "Fn::ImportValue": {
            "Fn::Sub": "\${Stack}-elasticsearch-\${Stage}-ElasticsearchSecurityGroup",
          },
        },
        "IpProtocol": "tcp",
        "SourceSecurityGroupId": {
          "Fn::GetAtt": "ElasticsearchAccessSecurityGroup.GroupId",
        },
        "ToPort": 9200,
      },
      "Type": "AWS::EC2::SecurityGroupIngress",
    },
    "FailureAlarm": {
      "Condition": "IsProd",
      "Properties": {
        "AlarmActions": [
          {
            "Fn::ImportValue": {
              "Fn::Sub": "\${Stack}-shared-AlertTopic",
            },
          },
        ],
        "AlarmDescription": "Errors handled by the FailureToResultMapper in Giant",
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "Dimensions": [
          {
            "Name": "Stack",
            "Value": {
              "Ref": "Stack",
            },
          },
          {
            "Name": "Stage",
            "Value": {
              "Ref": "Stage",
            },
          },
        ],
        "EvaluationPeriods": 1,
        "MetricName": "ErrorsInGiantFailureToResultMapper",
        "Namespace": "PFI",
        "Period": 60,
        "Statistic": "Sum",
        "Tags": [
          {
            "Key": "App",
            "Value": "pfi",
          },
          {
            "Key": "gu:cdk:version",
            "Value": "TEST",
          },
          {
            "Key": "gu:repo",
            "Value": "guardian/giant",
          },
          {
            "Key": "Stack",
            "Value": "pfi-giant",
          },
          {
            "Key": "Stage",
            "Value": "rex",
          },
        ],
        "Threshold": 1,
        "TreatMissingData": "notBreaching",
      },
      "Type": "AWS::CloudWatch::Alarm",
    },
    "FrontendAutoScalingGroup": {
      "Properties": {
        "AvailabilityZones": {
          "Fn::GetAZs": "",
        },
        "Cooldown": "180",
        "HealthCheckGracePeriod": 300,
        "HealthCheckType": "ELB",
        "LaunchConfigurationName": {
          "Ref": "FrontendLaunchConfig",
        },
        "MaxSize": {
          "Fn::If": [
            "DeployInstances",
            {
              "Fn::FindInMap": [
                "StackVariables",
                {
                  "Ref": "Stack",
                },
                "MaxWebAppInstanceCount",
              ],
            },
            0,
          ],
        },
        "MinSize": {
          "Fn::If": [
            "DeployInstances",
            {
              "Fn::FindInMap": [
                "StackVariables",
                {
                  "Ref": "Stack",
                },
                "MinWebAppInstanceCount",
              ],
            },
            0,
          ],
        },
        "Tags": [
          {
            "Key": "App",
            "PropagateAtLaunch": true,
            "Value": "pfi",
          },
          {
            "Key": "gu:cdk:version",
            "PropagateAtLaunch": true,
            "Value": "TEST",
          },
          {
            "Key": "gu:repo",
            "PropagateAtLaunch": true,
            "Value": "guardian/giant",
          },
          {
            "Key": "Stack",
            "PropagateAtLaunch": true,
            "Value": "pfi-giant",
          },
          {
            "Key": "Stage",
            "PropagateAtLaunch": true,
            "Value": "rex",
          },
        ],
        "TargetGroupARNs": [
          {
            "Fn::ImportValue": {
              "Fn::Sub": "\${Stack}-router-\${Stage}TargetGroup",
            },
          },
        ],
        "VPCZoneIdentifier": [
          {
            "Fn::ImportValue": {
              "Fn::Sub": "\${VPCStackName}-PrivateSubnet1a",
            },
          },
          {
            "Fn::ImportValue": {
              "Fn::Sub": "\${VPCStackName}-PrivateSubnet1b",
            },
          },
          {
            "Fn::ImportValue": {
              "Fn::Sub": "\${VPCStackName}-PrivateSubnet1c",
            },
          },
        ],
      },
      "Type": "AWS::AutoScaling::AutoScalingGroup",
    },
    "FrontendInstanceProfile": {
      "Properties": {
        "Path": "/",
        "Roles": [
          {
            "Ref": "FrontendRole",
          },
        ],
      },
      "Type": "AWS::IAM::InstanceProfile",
    },
    "FrontendLaunchConfig": {
      "Properties": {
        "IamInstanceProfile": {
          "Ref": "FrontendInstanceProfile",
        },
        "ImageId": {
          "Ref": "AMI",
        },
        "InstanceType": {
          "Fn::FindInMap": [
            "StackVariables",
            {
              "Ref": "Stack",
            },
            "WebAppInstanceType",
          ],
        },
        "MetadataOptions": {
          "HttpTokens": "required",
        },
        "SecurityGroups": [
          {
            "Fn::ImportValue": {
              "Fn::Sub": "\${Stack}-shared-CommonInstanceSecurityGroup",
            },
          },
          {
            "Fn::ImportValue": {
              "Fn::Sub": "\${PostgresStackName}-DbAccessSecurityGroup",
            },
          },
          {
            "Fn::GetAtt": "Neo4jAccessSecurityGroup.GroupId",
          },
          {
            "Fn::GetAtt": "ElasticsearchAccessSecurityGroup.GroupId",
          },
          {
            "Fn::GetAtt": "FrontendSecurityGroup.GroupId",
          },
        ],
        "UserData": {
          "Fn::Base64": {
            "Fn::Sub": [
              "#!/bin/bash -ev
export AWS_DEFAULT_REGION=\${AWS::Region}
aws s3 cp s3://\${DistBucket}/\${Stack}/\${Stage}/pfi/scripts/setup-pfi-instance.sh .
chmod u=rwx setup-pfi-instance.sh
./setup-pfi-instance.sh \${DistBucket} \${AWS::StackName}
",
              {
                "DistBucket": {
                  "Fn::ImportValue": {
                    "Fn::Sub": "\${Stack}-shared-DistBucket",
                  },
                },
              },
            ],
          },
        },
      },
      "Type": "AWS::AutoScaling::LaunchConfiguration",
    },
    "FrontendRole": {
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Statement": {
            "Action": [
              "sts:AssumeRole",
            ],
            "Effect": "Allow",
            "Principal": {
              "Service": [
                "ec2.amazonaws.com",
              ],
            },
          },
        },
        "ManagedPolicyArns": [
          {
            "Fn::ImportValue": {
              "Fn::Sub": "\${Stack}-shared-CommonInstancePolicy",
            },
          },
        ],
        "Path": "/",
        "Policies": [
          {
            "PolicyDocument": {
              "Statement": [
                {
                  "Action": "sts:AssumeRole",
                  "Effect": "Allow",
                  "Resource": {
                    "Fn::ImportValue": {
                      "Fn::Sub": "\${Stack}-buckets-\${Stage}-IngestionUploadRole",
                    },
                  },
                },
                {
                  "Action": [
                    "ec2:DescribeAvailabilityZones",
                    "ec2:DescribeAccountAttributes",
                    "ec2:DescribeSubnets",
                    "autoscaling:Describe*",
                  ],
                  "Effect": "Allow",
                  "Resource": "*",
                },
                {
                  "Action": [
                    "autoscaling:SetDesiredCapacity",
                  ],
                  "Effect": "Allow",
                  "Resource": [
                    {
                      "Fn::Sub": "arn:aws:autoscaling:\${AWS::Region}:\${AWS::AccountId}:autoScalingGroup:*:autoScalingGroupName/\${WorkerAutoScalingGroup}",
                    },
                    {
                      "Fn::Sub": "arn:aws:autoscaling:\${AWS::Region}:\${AWS::AccountId}:autoScalingGroup:*:autoScalingGroupName/\${SpotWorkerAutoScalingGroup}",
                    },
                  ],
                },
                {
                  "Action": [
                    "sns:Publish",
                  ],
                  "Effect": "Allow",
                  "Resource": [
                    {
                      "Ref": "RemoteIngestTopicArn",
                    },
                  ],
                },
                {
                  "Action": [
                    "s3:PutObject",
                  ],
                  "Effect": "Allow",
                  "Resource": [
                    {
                      "Fn::Sub": "arn:aws:s3:::\${Stack}-remote-ingest-data-\${Stage}/*",
                    },
                  ],
                },
                {
                  "Action": [
                    "s3:GetObject",
                  ],
                  "Effect": "Allow",
                  "Resource": {
                    "Fn::Sub": "arn:aws:s3:::investigations-data-dev/skincare/*",
                  },
                },
              ],
            },
            "PolicyName": "root",
          },
        ],
        "Tags": [
          {
            "Key": "App",
            "Value": "pfi",
          },
          {
            "Key": "gu:cdk:version",
            "Value": "TEST",
          },
          {
            "Key": "gu:repo",
            "Value": "guardian/giant",
          },
          {
            "Key": "Stack",
            "Value": "pfi-giant",
          },
          {
            "Key": "Stage",
            "Value": "rex",
          },
        ],
      },
      "Type": "AWS::IAM::Role",
    },
    "FrontendSecurityGroup": {
      "Properties": {
        "GroupDescription": "Investigations frontend",
        "SecurityGroupEgress": [
          {
            "DestinationSecurityGroupId": {
              "Fn::ImportValue": {
                "Fn::Sub": "\${Stack}-router-LoadBalancerSecurityGroup",
              },
            },
            "FromPort": 9001,
            "IpProtocol": "tcp",
            "ToPort": 9001,
          },
        ],
        "SecurityGroupIngress": [
          {
            "FromPort": 9001,
            "IpProtocol": "tcp",
            "SourceSecurityGroupId": {
              "Fn::ImportValue": {
                "Fn::Sub": "\${Stack}-router-LoadBalancerSecurityGroup",
              },
            },
            "ToPort": 9001,
          },
        ],
        "Tags": [
          {
            "Key": "App",
            "Value": "pfi",
          },
          {
            "Key": "gu:cdk:version",
            "Value": "TEST",
          },
          {
            "Key": "gu:repo",
            "Value": "guardian/giant",
          },
          {
            "Key": "Stack",
            "Value": "pfi-giant",
          },
          {
            "Key": "Stage",
            "Value": "rex",
          },
        ],
        "VpcId": {
          "Fn::ImportValue": {
            "Fn::Sub": "\${VPCStackName}-ID",
          },
        },
      },
      "Type": "AWS::EC2::SecurityGroup",
    },
    "InternodeCommunicationEgress": {
      "Properties": {
        "DestinationSecurityGroupId": {
          "Fn::GetAtt": "WorkerSecurityGroup.GroupId",
        },
        "FromPort": 1234,
        "GroupId": {
          "Ref": "WorkerSecurityGroup",
        },
        "IpProtocol": "tcp",
        "ToPort": 1234,
      },
      "Type": "AWS::EC2::SecurityGroupEgress",
    },
    "InternodeCommunicationIngress": {
      "Properties": {
        "FromPort": 1234,
        "GroupId": {
          "Ref": "WorkerSecurityGroup",
        },
        "IpProtocol": "tcp",
        "SourceSecurityGroupId": {
          "Fn::GetAtt": "WorkerSecurityGroup.GroupId",
        },
        "ToPort": 1234,
      },
      "Type": "AWS::EC2::SecurityGroupIngress",
    },
    "MediaDownloadOutputDeadLetterAlarm": {
      "Condition": "IsProd",
      "Properties": {
        "AlarmActions": [
          {
            "Fn::ImportValue": {
              "Fn::Sub": "\${Stack}-shared-AlertTopic",
            },
          },
        ],
        "AlarmDescription": "Message sent to MediaDownloadOutputDeadLetterQueue",
        "AlarmName": "Message sent to Giant media download output DLQ",
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "Dimensions": [
          {
            "Name": "QueueName",
            "Value": {
              "Fn::GetAtt": "MediaDownloadOutputDeadLetterQueue.QueueName",
            },
          },
        ],
        "EvaluationPeriods": 1,
        "MetricName": "ApproximateNumberOfMessagesVisible",
        "Namespace": "AWS/SQS",
        "Period": 60,
        "Statistic": "Sum",
        "Tags": [
          {
            "Key": "App",
            "Value": "pfi",
          },
          {
            "Key": "gu:cdk:version",
            "Value": "TEST",
          },
          {
            "Key": "gu:repo",
            "Value": "guardian/giant",
          },
          {
            "Key": "Stack",
            "Value": "pfi-giant",
          },
          {
            "Key": "Stage",
            "Value": "rex",
          },
        ],
        "Threshold": 1,
        "TreatMissingData": "notBreaching",
      },
      "Type": "AWS::CloudWatch::Alarm",
    },
    "MediaDownloadOutputDeadLetterQueue": {
      "DeletionPolicy": "Delete",
      "Properties": {
        "QueueName": {
          "Fn::Sub": "\${Stack}-media-download-output-dead-letter-queue-\${Stage}",
        },
        "Tags": [
          {
            "Key": "App",
            "Value": "pfi",
          },
          {
            "Key": "gu:cdk:version",
            "Value": "TEST",
          },
          {
            "Key": "gu:repo",
            "Value": "guardian/giant",
          },
          {
            "Key": "Stack",
            "Value": "pfi-giant",
          },
          {
            "Key": "Stage",
            "Value": "rex",
          },
        ],
      },
      "Type": "AWS::SQS::Queue",
      "UpdateReplacePolicy": "Delete",
    },
    "MediaDownloadOutputQueue": {
      "DeletionPolicy": "Delete",
      "Properties": {
        "QueueName": {
          "Fn::Sub": "\${Stack}-media-download-output-queue-\${Stage}",
        },
        "RedrivePolicy": {
          "deadLetterTargetArn": {
            "Fn::GetAtt": [
              "MediaDownloadOutputDeadLetterQueue",
              "Arn",
            ],
          },
          "maxReceiveCount": 3,
        },
        "Tags": [
          {
            "Key": "App",
            "Value": "pfi",
          },
          {
            "Key": "gu:cdk:version",
            "Value": "TEST",
          },
          {
            "Key": "gu:repo",
            "Value": "guardian/giant",
          },
          {
            "Key": "Stack",
            "Value": "pfi-giant",
          },
          {
            "Key": "Stage",
            "Value": "rex",
          },
        ],
        "VisibilityTimeout": 30,
      },
      "Type": "AWS::SQS::Queue",
      "UpdateReplacePolicy": "Delete",
    },
    "Neo4JHTTPIngress": {
      "Properties": {
        "FromPort": 7474,
        "GroupId": {
          "Fn::ImportValue": {
            "Fn::Sub": "\${Stack}-neo4j-\${Stage}-Neo4jSecurityGroup",
          },
        },
        "IpProtocol": "tcp",
        "SourceSecurityGroupId": {
          "Fn::GetAtt": "Neo4jAccessSecurityGroup.GroupId",
        },
        "ToPort": 7474,
      },
      "Type": "AWS::EC2::SecurityGroupIngress",
    },
    "Neo4jAccessSecurityGroup": {
      "Properties": {
        "GroupDescription": "Investigations frontend and worker access to neo4j",
        "SecurityGroupEgress": [
          {
            "DestinationSecurityGroupId": {
              "Fn::ImportValue": {
                "Fn::Sub": "\${Stack}-neo4j-\${Stage}-Neo4jSecurityGroup",
              },
            },
            "FromPort": 7474,
            "IpProtocol": "tcp",
            "ToPort": 7474,
          },
          {
            "DestinationSecurityGroupId": {
              "Fn::ImportValue": {
                "Fn::Sub": "\${Stack}-neo4j-\${Stage}-Neo4jSecurityGroup",
              },
            },
            "FromPort": 7687,
            "IpProtocol": "tcp",
            "ToPort": 7687,
          },
        ],
        "Tags": [
          {
            "Key": "App",
            "Value": "pfi",
          },
          {
            "Key": "gu:cdk:version",
            "Value": "TEST",
          },
          {
            "Key": "gu:repo",
            "Value": "guardian/giant",
          },
          {
            "Key": "Stack",
            "Value": "pfi-giant",
          },
          {
            "Key": "Stage",
            "Value": "rex",
          },
        ],
        "VpcId": {
          "Fn::ImportValue": {
            "Fn::Sub": "\${VPCStackName}-ID",
          },
        },
      },
      "Type": "AWS::EC2::SecurityGroup",
    },
    "Neo4jBoltIngress": {
      "Properties": {
        "FromPort": 7687,
        "GroupId": {
          "Fn::ImportValue": {
            "Fn::Sub": "\${Stack}-neo4j-\${Stage}-Neo4jSecurityGroup",
          },
        },
        "IpProtocol": "tcp",
        "SourceSecurityGroupId": {
          "Fn::GetAtt": "Neo4jAccessSecurityGroup.GroupId",
        },
        "ToPort": 7687,
      },
      "Type": "AWS::EC2::SecurityGroupIngress",
    },
    "SpotWorkerAutoScalingGroup": {
      "Properties": {
        "AvailabilityZones": {
          "Fn::GetAZs": "",
        },
        "Cooldown": "180",
        "HealthCheckGracePeriod": 300,
        "HealthCheckType": "ELB",
        "MaxSize": {
          "Fn::If": [
            "DeployInstances",
            {
              "Ref": "MaxNumberOfWorkersIncludingHeadroomForDeploy",
            },
            0,
          ],
        },
        "MetricsCollection": [
          {
            "Granularity": "1Minute",
          },
        ],
        "MinSize": "0",
        "MixedInstancesPolicy": {
          "InstancesDistribution": {
            "OnDemandAllocationStrategy": "lowest-price",
            "OnDemandBaseCapacity": 0,
            "OnDemandPercentageAboveBaseCapacity": 0,
            "SpotAllocationStrategy": "price-capacity-optimized",
            "SpotMaxPrice": "0.1",
          },
          "LaunchTemplate": {
            "LaunchTemplateSpecification": {
              "LaunchTemplateId": {
                "Ref": "WorkerLaunchTemplate",
              },
              "Version": {
                "Fn::GetAtt": "WorkerLaunchTemplate.LatestVersionNumber",
              },
            },
            "Overrides": [
              {
                "InstanceRequirements": {
                  "BurstablePerformance": {
                    "Fn::FindInMap": [
                      "StackVariables",
                      {
                        "Ref": "Stack",
                      },
                      "WorkerBurstablePerformance",
                    ],
                  },
                  "MemoryMiB": {
                    "Min": 8192,
                  },
                  "VCpuCount": {
                    "Min": 2,
                  },
                },
              },
            ],
          },
        },
        "Tags": [
          {
            "Key": "App",
            "PropagateAtLaunch": true,
            "Value": "pfi",
          },
          {
            "Key": "gu:cdk:version",
            "PropagateAtLaunch": true,
            "Value": "TEST",
          },
          {
            "Key": "gu:repo",
            "PropagateAtLaunch": true,
            "Value": "guardian/giant",
          },
          {
            "Key": "Stack",
            "PropagateAtLaunch": true,
            "Value": "pfi-giant",
          },
          {
            "Key": "Stage",
            "PropagateAtLaunch": true,
            "Value": "rex",
          },
        ],
        "TargetGroupARNs": [
          {
            "Fn::ImportValue": {
              "Fn::Sub": "\${Stack}-router-SpotWorkerTargetGroup",
            },
          },
        ],
        "VPCZoneIdentifier": [
          {
            "Fn::ImportValue": {
              "Fn::Sub": "\${VPCStackName}-PrivateSubnet1a",
            },
          },
          {
            "Fn::ImportValue": {
              "Fn::Sub": "\${VPCStackName}-PrivateSubnet1b",
            },
          },
          {
            "Fn::ImportValue": {
              "Fn::Sub": "\${VPCStackName}-PrivateSubnet1c",
            },
          },
        ],
      },
      "Type": "AWS::AutoScaling::AutoScalingGroup",
    },
    "TranscriptionOutputDeadLetterAlarm": {
      "Condition": "IsProd",
      "Properties": {
        "AlarmActions": [
          {
            "Fn::ImportValue": {
              "Fn::Sub": "\${Stack}-shared-AlertTopic",
            },
          },
        ],
        "AlarmDescription": "Message sent to TranscriptionOutputDeadLetterQueue",
        "AlarmName": "Message sent to Giant transcription output DLQ",
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "Dimensions": [
          {
            "Name": "QueueName",
            "Value": {
              "Fn::GetAtt": "TranscriptionOutputDeadLetterQueue.QueueName",
            },
          },
        ],
        "EvaluationPeriods": 1,
        "MetricName": "ApproximateNumberOfMessagesVisible",
        "Namespace": "AWS/SQS",
        "Period": 60,
        "Statistic": "Sum",
        "Tags": [
          {
            "Key": "App",
            "Value": "pfi",
          },
          {
            "Key": "gu:cdk:version",
            "Value": "TEST",
          },
          {
            "Key": "gu:repo",
            "Value": "guardian/giant",
          },
          {
            "Key": "Stack",
            "Value": "pfi-giant",
          },
          {
            "Key": "Stage",
            "Value": "rex",
          },
        ],
        "Threshold": 1,
        "TreatMissingData": "notBreaching",
      },
      "Type": "AWS::CloudWatch::Alarm",
    },
    "TranscriptionOutputDeadLetterQueue": {
      "DeletionPolicy": "Delete",
      "Properties": {
        "ContentBasedDeduplication": true,
        "FifoQueue": true,
        "QueueName": {
          "Fn::Sub": "\${Stack}-transcription-output-dead-letter-queue-\${Stage}.fifo",
        },
        "Tags": [
          {
            "Key": "App",
            "Value": "pfi",
          },
          {
            "Key": "gu:cdk:version",
            "Value": "TEST",
          },
          {
            "Key": "gu:repo",
            "Value": "guardian/giant",
          },
          {
            "Key": "Stack",
            "Value": "pfi-giant",
          },
          {
            "Key": "Stage",
            "Value": "rex",
          },
        ],
      },
      "Type": "AWS::SQS::Queue",
      "UpdateReplacePolicy": "Delete",
    },
    "TranscriptionOutputQueue": {
      "DeletionPolicy": "Delete",
      "Properties": {
        "ContentBasedDeduplication": true,
        "FifoQueue": true,
        "QueueName": {
          "Fn::Sub": "\${Stack}-transcription-output-queue-\${Stage}.fifo",
        },
        "RedrivePolicy": {
          "deadLetterTargetArn": {
            "Fn::GetAtt": [
              "TranscriptionOutputDeadLetterQueue",
              "Arn",
            ],
          },
          "maxReceiveCount": 3,
        },
        "Tags": [
          {
            "Key": "App",
            "Value": "pfi",
          },
          {
            "Key": "gu:cdk:version",
            "Value": "TEST",
          },
          {
            "Key": "gu:repo",
            "Value": "guardian/giant",
          },
          {
            "Key": "Stack",
            "Value": "pfi-giant",
          },
          {
            "Key": "Stage",
            "Value": "rex",
          },
        ],
        "VisibilityTimeout": 30,
      },
      "Type": "AWS::SQS::Queue",
      "UpdateReplacePolicy": "Delete",
    },
    "WorkerAutoScalingGroup": {
      "Properties": {
        "AvailabilityZones": {
          "Fn::GetAZs": "",
        },
        "Cooldown": "180",
        "HealthCheckGracePeriod": 300,
        "HealthCheckType": "ELB",
        "LaunchTemplate": {
          "LaunchTemplateId": {
            "Ref": "WorkerLaunchTemplate",
          },
          "Version": {
            "Fn::GetAtt": "WorkerLaunchTemplate.LatestVersionNumber",
          },
        },
        "MaxSize": {
          "Fn::If": [
            "DeployInstances",
            {
              "Ref": "MaxNumberOfWorkersIncludingHeadroomForDeploy",
            },
            0,
          ],
        },
        "MetricsCollection": [
          {
            "Granularity": "1Minute",
          },
        ],
        "MinSize": {
          "Fn::If": [
            "DeployInstances",
            {
              "Ref": "MinNumberOfWorkers",
            },
            0,
          ],
        },
        "Tags": [
          {
            "Key": "App",
            "PropagateAtLaunch": true,
            "Value": "pfi",
          },
          {
            "Key": "gu:cdk:version",
            "PropagateAtLaunch": true,
            "Value": "TEST",
          },
          {
            "Key": "gu:repo",
            "PropagateAtLaunch": true,
            "Value": "guardian/giant",
          },
          {
            "Key": "Stack",
            "PropagateAtLaunch": true,
            "Value": "pfi-giant",
          },
          {
            "Key": "Stage",
            "PropagateAtLaunch": true,
            "Value": "rex",
          },
        ],
        "TargetGroupARNs": [
          {
            "Fn::ImportValue": {
              "Fn::Sub": "\${Stack}-router-WorkerTargetGroup",
            },
          },
        ],
        "VPCZoneIdentifier": [
          {
            "Fn::ImportValue": {
              "Fn::Sub": "\${VPCStackName}-PrivateSubnet1a",
            },
          },
          {
            "Fn::ImportValue": {
              "Fn::Sub": "\${VPCStackName}-PrivateSubnet1b",
            },
          },
          {
            "Fn::ImportValue": {
              "Fn::Sub": "\${VPCStackName}-PrivateSubnet1c",
            },
          },
        ],
      },
      "Type": "AWS::AutoScaling::AutoScalingGroup",
    },
    "WorkerFailureAlarm": {
      "Condition": "IsProd",
      "Properties": {
        "AlarmActions": [
          {
            "Fn::ImportValue": {
              "Fn::Sub": "\${Stack}-shared-AlertTopic",
            },
          },
        ],
        "AlarmDescription": "Errors from ingest workers",
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "Dimensions": [
          {
            "Name": "Stack",
            "Value": {
              "Ref": "Stack",
            },
          },
          {
            "Name": "Stage",
            "Value": {
              "Ref": "Stage",
            },
          },
        ],
        "EvaluationPeriods": 1,
        "MetricName": "IngestItemsFailed",
        "Namespace": "PFI",
        "Period": 60,
        "Statistic": "Sum",
        "Tags": [
          {
            "Key": "App",
            "Value": "pfi",
          },
          {
            "Key": "gu:cdk:version",
            "Value": "TEST",
          },
          {
            "Key": "gu:repo",
            "Value": "guardian/giant",
          },
          {
            "Key": "Stack",
            "Value": "pfi-giant",
          },
          {
            "Key": "Stage",
            "Value": "rex",
          },
        ],
        "Threshold": 1,
        "TreatMissingData": "notBreaching",
      },
      "Type": "AWS::CloudWatch::Alarm",
    },
    "WorkerInstanceProfile": {
      "Properties": {
        "Path": "/",
        "Roles": [
          {
            "Ref": "WorkerRole",
          },
        ],
      },
      "Type": "AWS::IAM::InstanceProfile",
    },
    "WorkerLaunchTemplate": {
      "Properties": {
        "LaunchTemplateData": {
          "IamInstanceProfile": {
            "Arn": {
              "Fn::GetAtt": "WorkerInstanceProfile.Arn",
            },
          },
          "ImageId": {
            "Ref": "AMI",
          },
          "InstanceType": {
            "Ref": "WorkerInstanceType",
          },
          "MetadataOptions": {
            "HttpTokens": "required",
          },
          "SecurityGroupIds": [
            {
              "Fn::ImportValue": {
                "Fn::Sub": "\${Stack}-shared-CommonInstanceSecurityGroup",
              },
            },
            {
              "Fn::ImportValue": {
                "Fn::Sub": "\${PostgresStackName}-DbAccessSecurityGroup",
              },
            },
            {
              "Fn::GetAtt": "Neo4jAccessSecurityGroup.GroupId",
            },
            {
              "Fn::GetAtt": "ElasticsearchAccessSecurityGroup.GroupId",
            },
            {
              "Fn::GetAtt": "WorkerSecurityGroup.GroupId",
            },
          ],
          "UserData": {
            "Fn::Base64": {
              "Fn::Sub": [
                "#!/bin/bash -ev
export AWS_DEFAULT_REGION=\${AWS::Region}
aws s3 cp s3://\${DistBucket}/\${Stack}/\${Stage}/pfi/scripts/setup-pfi-instance.sh .
chmod u=rwx setup-pfi-instance.sh
./setup-pfi-instance.sh \${DistBucket} \${AWS::StackName} \${DataVolumeKeyArn}
",
                {
                  "DataVolumeKeyArn": {
                    "Fn::ImportValue": {
                      "Fn::Sub": "\${Stack}-shared-KmsKeyArn",
                    },
                  },
                  "DistBucket": {
                    "Fn::ImportValue": {
                      "Fn::Sub": "\${Stack}-shared-DistBucket",
                    },
                  },
                },
              ],
            },
          },
        },
      },
      "Type": "AWS::EC2::LaunchTemplate",
    },
    "WorkerRole": {
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Statement": {
            "Action": [
              "sts:AssumeRole",
            ],
            "Effect": "Allow",
            "Principal": {
              "Service": [
                "ec2.amazonaws.com",
              ],
            },
          },
        },
        "ManagedPolicyArns": [
          {
            "Fn::ImportValue": {
              "Fn::Sub": "\${Stack}-shared-CommonInstancePolicy",
            },
          },
        ],
        "Path": "/",
        "Policies": [
          {
            "PolicyDocument": {
              "Statement": [
                {
                  "Action": [
                    "sqs:SendMessage",
                    "sqs:GetQueueAttributes",
                    "sqs:GetQueueUrl",
                  ],
                  "Effect": "Allow",
                  "Resource": [
                    {
                      "Ref": "TranscriptionServiceTaskQueueArn",
                    },
                    {
                      "Ref": "TranscriptionServiceGpuTaskQueueArn",
                    },
                  ],
                },
                {
                  "Action": [
                    "sqs:ReceiveMessage",
                    "sqs:ChangeMessageVisibility",
                    "sqs:GetQueueUrl",
                    "sqs:DeleteMessage",
                    "sqs:GetQueueAttributes",
                  ],
                  "Effect": "Allow",
                  "Resource": [
                    {
                      "Fn::GetAtt": "TranscriptionOutputQueue.Arn",
                    },
                    {
                      "Fn::GetAtt": "MediaDownloadOutputQueue.Arn",
                    },
                  ],
                },
                {
                  "Action": [
                    "sqs:SendMessage",
                  ],
                  "Effect": "Allow",
                  "Resource": [
                    {
                      "Fn::GetAtt": "TranscriptionOutputDeadLetterQueue.Arn",
                    },
                    {
                      "Fn::GetAtt": "MediaDownloadOutputDeadLetterQueue.Arn",
                    },
                  ],
                },
                {
                  "Action": [
                    "s3:GetObject",
                    "s3:PutObject",
                  ],
                  "Effect": "Allow",
                  "Resource": [
                    {
                      "Fn::Sub": "arn:aws:s3:::\${Stack}-transcription-output-data-\${Stage}/*",
                    },
                  ],
                },
                {
                  "Action": [
                    "s3:GetObject",
                    "s3:ListBucket",
                  ],
                  "Effect": "Allow",
                  "Resource": [
                    {
                      "Fn::Sub": "arn:aws:s3:::\${Stack}-remote-ingest-data-\${Stage}/*",
                    },
                    {
                      "Fn::Sub": "arn:aws:s3:::\${Stack}-remote-ingest-data-\${Stage}",
                    },
                  ],
                },
              ],
              "Version": "2012-10-17",
            },
            "PolicyName": "TranscriptionPolicy",
          },
        ],
        "Tags": [
          {
            "Key": "App",
            "Value": "pfi",
          },
          {
            "Key": "gu:cdk:version",
            "Value": "TEST",
          },
          {
            "Key": "gu:repo",
            "Value": "guardian/giant",
          },
          {
            "Key": "Stack",
            "Value": "pfi-giant",
          },
          {
            "Key": "Stage",
            "Value": "rex",
          },
        ],
      },
      "Type": "AWS::IAM::Role",
    },
    "WorkerSecurityGroup": {
      "Properties": {
        "GroupDescription": "Investigations workers",
        "SecurityGroupEgress": [
          {
            "DestinationSecurityGroupId": {
              "Fn::ImportValue": {
                "Fn::Sub": "\${Stack}-router-WorkerLoadBalancerSecurityGroup",
              },
            },
            "FromPort": 9001,
            "IpProtocol": "tcp",
            "ToPort": 9001,
          },
        ],
        "SecurityGroupIngress": [
          {
            "FromPort": 9001,
            "IpProtocol": "tcp",
            "SourceSecurityGroupId": {
              "Fn::ImportValue": {
                "Fn::Sub": "\${Stack}-router-WorkerLoadBalancerSecurityGroup",
              },
            },
            "ToPort": 9001,
          },
        ],
        "Tags": [
          {
            "Key": "App",
            "Value": "pfi",
          },
          {
            "Key": "gu:cdk:version",
            "Value": "TEST",
          },
          {
            "Key": "gu:repo",
            "Value": "guardian/giant",
          },
          {
            "Key": "Stack",
            "Value": "pfi-giant",
          },
          {
            "Key": "Stage",
            "Value": "rex",
          },
        ],
        "VpcId": {
          "Fn::ImportValue": {
            "Fn::Sub": "\${VPCStackName}-ID",
          },
        },
      },
      "Type": "AWS::EC2::SecurityGroup",
    },
  },
}
`;
