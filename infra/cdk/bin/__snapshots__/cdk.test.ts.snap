          },
        ],
        "AlarmDescription": "Message sent to TranscriptionOutputDeadLetterQueue",
        "AlarmName": "Message sent to Giant transcription output DLQ",
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "Dimensions": [
          {
            "Name": "QueueName",
            "Value": {
              "Fn::GetAtt": "TranscriptionOutputDeadLetterQueue.QueueName",
            },
          },
        ],
        "EvaluationPeriods": 1,
        "MetricName": "ApproximateNumberOfMessagesVisible",
        "Namespace": "AWS/SQS",
        "Period": 60,
        "Statistic": "Sum",
        "Tags": [
          {
            "Key": "App",
            "Value": "pfi",
          },
          {
