exports[`Giant's riff-raff.yaml(s) should match the snapshot 1`] = `
"# This file was generated by @guardian/cdk, do not edit it directly.
# See also https://github.com/guardian/cdk/blob/main/src/riff-raff-yaml-file/README.md.
allowedStages:
  - CODE
  - PROD
deployments:
  cfn-eu-west-1-pfi-giant-postgres:
    type: cloud-formation
    regions:
      - eu-west-1
    stacks:
      - pfi-giant
    app: postgres
    contentDirectory: cdk.out
    parameters:
      templateStagePaths:
        CODE: pfi-giant-postgres-CODE.template.json
        PROD: pfi-giant-postgres-PROD.template.json
"
`;

exports[`Giant's riff-raff.yaml(s) should match the snapshot 2`] = `
"# This file was generated by @guardian/cdk, do not edit it directly.
# See also https://github.com/guardian/cdk/blob/main/src/riff-raff-yaml-file/README.md.
allowedStages:
  - rex
deployments:
  cfn-eu-west-1-pfi-playground-main-giant-stack:
    type: cloud-formation
    regions:
      - eu-west-1
    stacks:
      - pfi-playground
    app: pfi
    contentDirectory: cdk.out
    parameters:
      templateStagePaths:
        rex: pfi-playground-investigations-rex.template.json
  pfi-ami-update:
    type: ami-cloudformation-parameter
    app: pfi
    stacks:
      - pfi-playground
    regions:
      - eu-west-1
    contentDirectory: ''
    parameters:
      amiEncrypted: true
      amiTags:
        Recipe: investigations-giant-app-arm
        AmigoStage: PROD
    dependencies:
      - cfn-eu-west-1-pfi-playground-main-giant-stack
  pfi-neo4j-ami-update:
    type: ami-cloudformation-parameter
    app: neo4j
    stacks:
      - pfi-playground
    regions:
      - eu-west-1
    contentDirectory: ''
    parameters:
      amiEncrypted: true
      amiTags:
        Recipe: investigations-neo4j-2026-jammy-java25
        AmigoStage: PROD
    dependencies:
      - cfn-eu-west-1-pfi-playground-main-giant-stack
  pfi-elasticsearch-ami-update:
    type: ami-cloudformation-parameter
    app: elasticsearch
    stacks:
      - pfi-playground
    regions:
      - eu-west-1
    contentDirectory: ''
    parameters:
      amiEncrypted: true
      amiTags:
        Recipe: investigations-elasticsearch-8-arm64
        AmigoStage: PROD
    dependencies:
      - cfn-eu-west-1-pfi-playground-main-giant-stack
  pfi:
    type: autoscaling
    app: pfi
    stacks:
      - pfi-playground
    regions:
      - eu-west-1
    contentDirectory: pfi
    parameters:
      bucketSsmKey: /pfi-playground/artifact.bucket
      bucketSsmLookup: true
    dependencies:
      - cfn-eu-west-1-pfi-playground-main-giant-stack
      - pfi-ami-update
  pfi-worker:
    type: autoscaling
    app: pfi
    stacks:
      - pfi-playground
    regions:
      - eu-west-1
    contentDirectory: pfi
    parameters:
      bucketSsmKey: /pfi-playground/artifact.bucket
      bucketSsmLookup: true
    actions:
      - deploy
    dependencies:
      - cfn-eu-west-1-pfi-playground-main-giant-stack
      - pfi
  pfi-spot-worker:
    type: autoscaling
    app: pfi
    stacks:
      - pfi-playground
    regions:
      - eu-west-1
    contentDirectory: pfi
    parameters:
      bucketSsmKey: /pfi-playground/artifact.bucket
      bucketSsmLookup: true
    actions:
      - deploy
    dependencies:
      - cfn-eu-west-1-pfi-playground-main-giant-stack
      - pfi
  pfi-cli:
    type: aws-s3
    app: pfi-cli
    stacks:
      - pfi-playground
    regions:
      - eu-west-1
    contentDirectory: pfi-cli
    parameters:
      bucket: pfi-playground-dist
      cacheControl: private
      publicReadAcl: false
    dependencies:
      - cfn-eu-west-1-pfi-playground-main-giant-stack
  pfi-public-downloads:
    type: aws-s3
    app: pfi-public-downloads
    stacks:
      - pfi-playground
    regions:
      - eu-west-1
    contentDirectory: pfi-public-downloads
    parameters:
      bucket: investigations-public-dist
      cacheControl: private
      publicReadAcl: false
    dependencies:
      - cfn-eu-west-1-pfi-playground-main-giant-stack
"
`;

