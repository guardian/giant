{
  "name": "cdk",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test-update": "jest -u",
    "format": "prettier --write \"{lib,bin}/**/*.ts\"",
    "lint": "eslint lib/** bin/** --ext .ts --no-error-on-unmatched-pattern",
    "synth": "cdk synth --path-metadata false --version-reporting false --quiet",
    "diff": "cdk diff --path-metadata false --version-reporting false"
  },
  "devDependencies": {
    "@guardian/cdk": "64.7.0",
    "@guardian/eslint-config": "14.0.1",
    "@guardian/node-riffraff-artifact": "^0.3.2",
    "@guardian/prettier": "5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "20.19.43",
    "aws-cdk": "2.1148.1",
    "aws-cdk-lib": "2.277.0",
    "constructs": "10.8.1",
    "eslint": "^9.39.5",
    "eslint-plugin-import-x": "4.16.1",
    "jest": "^29.7.0",
    "prettier": "^3.10.1",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "5.9.3"
  },
  "prettier": "@guardian/prettier",
  "jest": {
    "testMatch": [
      "<rootDir>/lib/**/*.test.ts",
      "<rootDir>/bin/**/*.test.ts"
    ],
    "transform": {
      "^.+\\.tsx?$": "ts-jest"
    },
    "setupFilesAfterEnv": [
      "./jest.setup.js"
    ]
  }
}
