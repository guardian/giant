      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "userEmail": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "const": "LLM_FAILURE"
        }
      },
      "required": [
        "id",
        "userEmail",
        "status"
      ],
      "additionalProperties": false
    },
