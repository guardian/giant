        "transcriptTranslations": {
          "$ref": "#/$defs/Transcripts"
        },
        "metadata": {
          "$ref": "#/$defs/TranscriptionMetadata"
        }
      },
      "required": [
        "transcripts",
        "metadata"
      ],
      "additionalProperties": false
    },
    "TranscriptionOutput": {
      "oneOf": [
        {
          "$ref": "#/$defs/TranscriptionOutputSuccess"
        },
        {
          "$ref": "#/$defs/TranscriptionOutputFailure"
        },
        {
          "$ref": "#/$defs/MediaDownloadFailure"
        },
        {
          "$ref": "#/$defs/LLMOutputSuccess"
        },
        {
          "$ref": "#/$defs/LLMOutputFailure"
        }
      ]
    },
    "MediaDownloadFailure": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "userEmail": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "const": "MEDIA_DOWNLOAD_FAILURE"
        },
        "failureReason": {
          "type": "string",
          "enum": [
            "FAILURE",
            "INVALID_URL",
            "BOT_BLOCKED"
          ]
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "userEmail",
        "status",
        "failureReason",
        "url"
      ],
      "additionalProperties": false
